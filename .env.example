# Model slug lives in src/config/model_config.py (google/gemini-2.5-flash), not here.
LLM_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=project-3b0c96e7-a43e-4f65-8bd
VERTEX_LOCATION=global
GOOGLE_API_KEY=

# Optional legacy OpenRouter path (LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Neon Postgres — prefer DATABASE_URL from `neon link` / `neon deploy`
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production

# Optional explicit Postgres overrides (usually unnecessary with DATABASE_URL)
# POSTGRES_HOST=
# POSTGRES_PORT=5432
# POSTGRES_DB=neondb
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_READ_USER=
# POSTGRES_READ_PASSWORD=

APP_ENV=development
LOG_LEVEL=INFO
MAX_CONCURRENT_CASES=4
MAX_CONCURRENT_LLM_CALLS=4
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3

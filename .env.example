# Model slug lives in src/config/model_config.py (openai/gpt-5-nano), not here.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Match your local Postgres. Existing container often uses:
#   POSTGRES_DB=olist_disputes / POSTGRES_PASSWORD=olist
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=olist_disputes
POSTGRES_USER=olist
POSTGRES_PASSWORD=olist
POSTGRES_READ_USER=olist
POSTGRES_READ_PASSWORD=olist

APP_ENV=development
LOG_LEVEL=INFO
MAX_CONCURRENT_CASES=4
MAX_CONCURRENT_LLM_CALLS=4
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3
